{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PulseBay",
  "version": "0.1.0",
  "identifier": "io.jeanseenivasagam.pulsebay",
  "build": {
    "devUrl": "http://localhost:5175",
    "frontendDist": "../../web-ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PulseBay — Operations & Booking Console",
        "width": 1280,
        "height": 840,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; script-src 'self';"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Jean Seenivasagam",
    "copyright": "Copyright (c) 2026 Jean Seenivasagam",
    "shortDescription": "PulseBay Operations & Booking Console",
    "longDescription": "Standalone Rust scheduling console with interactive calendar booking, local SQLite storage, and native Excel (.xlsx), CSV, and PDF report exports.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
